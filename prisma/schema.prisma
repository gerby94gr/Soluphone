datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())

  email     String   @unique
  name      String?
  password  String

  createdAt DateTime @default(now())

  orders    Order[]
}

model Customer {
  id        String   @id @default(cuid())

  name      String
  phone     String?
  email     String?

  createdAt DateTime @default(now())

  orders    Order[]
}

model Order {
  id          String   @id @default(cuid())

  clientName  String
  device      String
  problem     String?

  status      String   @default("received")

  price       Int?
  notes       String?

  createdAt   DateTime @default(now())

  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])

  userId      String?
  user        User? @relation(fields: [userId], references: [id])
}